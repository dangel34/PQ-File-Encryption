# nginx site config for the pqfile web app (WASM/egui single-page app).
#
# Deployed to /etc/nginx/sites-available/pqfile and symlinked into
# sites-enabled/. The three included snippets live in /etc/nginx/snippets/.
# See nginx/README.md for how the deploy workflow installs and validates these.
#
# Listens on localhost only; TLS is terminated at the Cloudflare edge and traffic
# arrives via a cloudflared tunnel (see snippets/cloudflare-ips.conf).

server {
    listen 127.0.0.1:80;
    server_name pqfile.nappi.work;

    root /var/www/pqfile;
    index index.html;

    include snippets/security-headers-pqfile.conf;
    include snippets/wasm-headers.conf;
    include snippets/cloudflare-ips.conf;

    server_tokens off;

    # Dynamic gzip fallback for content not already compressed.
    gzip            on;
    gzip_vary       on;
    gzip_proxied    any;
    gzip_comp_level 6;
    gzip_types      text/plain text/css application/javascript
                    application/json application/wasm;

    # Serve pre-compressed .gz files produced by the CI pre-compress step.
    # nginx picks dist/foo.wasm.gz over dist/foo.wasm when the client sends
    # Accept-Encoding: gzip (true of all modern browsers).
    gzip_static on;
    brotli_static on;

    # Deny dotfiles BEFORE the static-file regex locations below. nginx evaluates
    # regex locations top-to-bottom and stops at the first match, so this must come
    # first: otherwise a request for a dotfile ending in .js/.wasm/.css (e.g.
    # "/.env.js") would match the static-asset block and be served with a long-lived
    # cache, bypassing this deny. Ordering it first closes that gap.
    location ~ /\. {
        deny all;
    }

    # index.html - always revalidate; new deploy = new hashed WASM/JS names.
    location = /index.html {
        expires -1;
        add_header Cache-Control "no-cache, must-revalidate";
        include snippets/security-headers-pqfile.conf;
        include snippets/wasm-headers.conf;
    }

    # Service worker - browsers enforce a 24 h max-age anyway, but serve
    # no-cache so updates propagate without waiting for that window.
    location = /sw.js {
        expires -1;
        add_header Cache-Control "no-cache, must-revalidate";
        include snippets/security-headers-pqfile.conf;
        include snippets/wasm-headers.conf;
    }

    location / {
        try_files $uri $uri/ =404;
    }

    # Trunk content-hashes all WASM and JS output - cache permanently.
    location ~* \.(wasm|js)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include snippets/security-headers-pqfile.conf;
        include snippets/wasm-headers.conf;
    }

    location ~* \.(css|png|svg|ico|woff2)$ {
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable";
        include snippets/security-headers-pqfile.conf;
        include snippets/wasm-headers.conf;
    }

    limit_req   zone=general burst=50 nodelay;
    access_log  /var/log/nginx/access.log cloudflare;
}
